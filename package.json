{
  "name": "dsh-agent-packages",
  "version": "0.1.0",
  "description": "统一管理多 Harness（Codex / Claude Code / Antigravity / DSH）Skills 与 MCP Server 版本与安装的 DSH 插件",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "check": "npm run build && npm test && npm run test:ui",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "esbuild": "0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
